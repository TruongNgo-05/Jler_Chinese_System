# Copy this file to .env and replace the example credentials before starting.
DB_URL=jdbc:mysql://localhost:3306/jler_chinese_system?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=your-mysql-username
DB_PASSWORD=replace-with-your-local-mysql-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

SERVER_PORT=8080
DDL_AUTO=update
UPLOAD_DIR=uploads
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO=false

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

SEPAY_ENABLED=false
SEPAY_WEBHOOK_KEY=
SEPAY_BANK_CODE=
SEPAY_GATEWAY=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_SUB_ACCOUNT=
